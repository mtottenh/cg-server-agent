[Unit]
Description=Portal game-server update helper (%i)
Documentation=https://github.com/mtottenh/cg-server-agent#game-server-updates

[Service]
# The instance name is the operation: check | lgsm | game | mods | all |
# repair-config | verify-config. The agent (user portal-agent) may start exactly these
# instances and nothing else — see 50-portal-gs-update.rules. The helper
# takes no other input from the unit: the portal's job id travels in
# /run/portal-gs-update/request.json.
Type=oneshot
ExecStart=/usr/sbin/portal-gs-update %i
SyslogIdentifier=portal-gs-update
# LinuxGSM starts CS2 inside a tmux server that must outlive this job, and
# it lives in this unit's cgroup. control-group (the default) and mixed both
# kill the whole cgroup when the unit stops — i.e. when the helper exits —
# and would take the game server with it. So: process. systemd then signals
# only the helper; the helper's exit handler kills its own LinuxGSM command
# (a separate session, so the whole process group goes) and, if the job had
# stopped the server, restores the plugin snapshot when needed and starts it
# again. Nothing of the job is left running without the lock.
KillMode=process
# Above the sum of the helper's own bounds for the longest path (`all` with
# a rollback: ~95 min, see lgsm_timeout in the helper).
TimeoutStartSec=2h
# On stop or timeout the helper gets SIGTERM and needs time for the recovery
# above (snapshot restore, start, verify) before systemd resorts to SIGKILL.
TimeoutStopSec=15min
