[Unit]
Description=Portal game-server update helper (%i)
Documentation=https://github.com/mtottenh/cg-server-agent#game-server-updates

[Service]
# The instance name is the operation: check | lgsm | game | mods | all |
# repair-config. The agent (user portal-agent) may start exactly these
# instances and nothing else — see 50-portal-gs-update.rules. The helper
# takes no other input from the unit: the portal's job id travels in
# /run/portal-gs-update/request.json.
Type=oneshot
ExecStart=/usr/sbin/portal-gs-update %i
SyslogIdentifier=portal-gs-update
# LinuxGSM starts CS2 inside a tmux server that must outlive this job. The
# default (control-group) would kill it the moment the helper exits.
KillMode=process
# SteamCMD on a slow day plus a rollback; the helper bounds each LinuxGSM
# command itself (30 min).
TimeoutStartSec=90min
