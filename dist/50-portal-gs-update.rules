// Installed by portal-server-agent.
//
// The agent runs unprivileged (NoNewPrivileges, no sudo). This is its one
// privilege: starting the update helper's template unit, and only with an
// operation from the closed list. It cannot stop, restart, enable or edit
// those units, and cannot touch any other unit.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "portal-agent" &&
        action.lookup("verb") == "start" &&
        /^portal-gs-update@(check|lgsm|game|mods|all|repair-config)\.service$/.test(action.lookup("unit"))) {
        return polkit.Result.YES;
    }
});
