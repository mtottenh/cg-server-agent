# portal-server-agent configuration
# Copy to /etc/portal/portal-server-agent.env and fill in.

# The portal's agent endpoint (Caddy client_auth site).
PORTAL_AGENT_URL=wss://agents.example.com/v1/gameserver/agent/ws

# Material written by `portal-server-agent enroll`.
PORTAL_AGENT_CERT=/etc/portal/agent/client.pem
PORTAL_AGENT_KEY=/etc/portal/agent/client.key
PORTAL_AGENT_CA=/etc/portal/agent/portal-ca.pem

# Local CS2 server RCON (requires -usercon on the server command line).
RCON_ADDR=127.0.0.1:27015
RCON_PASSWORD=change-me

# Heartbeat cadence (seconds). The portal marks servers offline after 90s
# of silence — do not raise this above 60.
PORTAL_AGENT_HEARTBEAT_SECS=30

# Optional local diagnostics: a loopback Prometheus /metrics listener for
# THIS host's operator (agent_ws_connected, agent_reconnects_total,
# agent_backoff_seconds, agent_heartbeats_sent_total,
# agent_rcon_commands_total{command,outcome}, agent_rcon_duration_seconds).
# The portal never scrapes agents — it monitors them via its own heartbeat
# aggregation. Keep this on 127.0.0.1; empty/unset = disabled.
# METRICS_ADDR=127.0.0.1:9469

# RUST_LOG=info
