[Unit]
Description=Portal game-server agent (MatchZy control channel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Static system user created by the deb postinst. NOT DynamicUser: the
# enrollment material in /etc/portal/agent is written by `enroll` (run as
# root) and chowned to portal-agent — a transient UID could never read it.
User=portal-agent
Group=portal-agent
EnvironmentFile=/etc/portal/portal-server-agent.env
ExecStart=/usr/bin/portal-server-agent
Restart=always
RestartSec=5

# Hardening (mirrors the portal service units)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# `-` = tolerate the path not existing yet: the dir is created by `enroll`,
# which may run after the first `systemctl start` attempt (restart the agent
# after enrolling, or these stay read-only for the running process).
# Writable for one file: matchzy_overrides.cfg (portal-managed MatchZy
# overrides, written atomically, so the directory must be writable). The
# agent already owns everything in here.
ReadWritePaths=-/etc/portal/agent
# request.json for the update helper; its state.json is read from here too.
# (/var/lib/portal-gs-update is only read, which ProtectSystem allows.)
ReadWritePaths=-/run/portal-gs-update
# /var/lib/portal-server-agent: which update results the portal has
# acknowledged, and the one result (if any) only the agent has a copy of.
StateDirectory=portal-server-agent
# The helper is started with `systemctl start` over the system D-Bus
# (AF_UNIX below); polkit decides, see 50-portal-gs-update.rules.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
